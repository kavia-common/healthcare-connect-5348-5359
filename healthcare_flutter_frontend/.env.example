# Backend base URL used by the Flutter app (loaded via flutter_dotenv)
# NOTE:
# - Android emulator uses 10.0.2.2 to access host machine's localhost
# - iOS simulator can use http://localhost
# - For real devices, use your machine's LAN IP, e.g., http://192.168.1.50:8000

# Common local dev examples:
# ANDROID EMULATOR:
# BACKEND_BASE_URL=http://10.0.2.2:8000
# IOS SIMULATOR:
# BACKEND_BASE_URL=http://localhost:8000

# Replace with your environment's URL:
BACKEND_BASE_URL=http://10.0.2.2:8000
